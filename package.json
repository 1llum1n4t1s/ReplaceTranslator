{
  "name": "replace-translator",
  "version": "1.0.11",
  "type": "commonjs",
  "description": "Chrome/Firefox extension that translates the current page in-place using cloud LLMs (OpenAI, Anthropic, Google Gemini, xAI Grok) via your own API key.",
  "scripts": {
    "ci:install": "pnpm install --frozen-lockfile",
    "test": "node --test",
    "lint": "eslint src/ test/"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "^4.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "web-ext": "^10.4.0"
  },
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "translation",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "xai",
    "grok",
    "page-translator"
  ],
  "author": "",
  "license": "MIT"
}
